{
  "name": "ai-logic-sensitive-data",
  "description": "Cloud Functions for Firebase (2nd Gen) sample using Cloud Sensitive Data Protection to redact sensitive data before and after AI Logic requests",
  "main": "index.js",
  "type": "module",
  "engines": {
    "node": "24"
  },
  "scripts": {
    "lint": "eslint .",
    "test": "node --test index.test.js",
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "compile": "cp ../../../tsconfig.template.json ./tsconfig-compile.json && tsc --project tsconfig-compile.json"
  },
  "dependencies": {
    "@google-cloud/dlp": "^6.0.0",
    "firebase-admin": "^14.2.0",
    "firebase-functions": "^7.4.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "eslint": "^8.57.1",
    "eslint-config-google": "^0.14.0"
  },
  "private": true
}
